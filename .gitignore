# Raw data files -- kept out of git because they're large (tens of MB) and
# easily re-downloaded from the UCI source; committing them would bloat the
# repo for no real benefit. The folder itself is preserved via .gitkeep.
data/raw/*.csv
data/raw/*.xlsx
!data/raw/.gitkeep

# Staged/output data -- also excluded by default. These are regenerated by
# running the SQL scripts + export_customer_rfm.py, so they're reproducible
# rather than something that needs to live in version control.
data/staged/*.csv
data/model_outputs/*.csv
!data/staged/.gitkeep
!data/model_outputs/.gitkeep

# Jupyter checkpoint files -- auto-generated, never meant to be committed
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Environment / secrets -- in case a future script stores a connection
# string or credentials in a .env file instead of hardcoding it
.env

# OS-generated clutter
.DS_Store
Thumbs.db

# Power BI -- .pbix files can get large and are binary, so diffs are
# meaningless. Keeping this commented out for now since you'll likely want
# the .pbix itself in the repo for the portfolio piece to be complete --
# uncomment the line below only if it grows unreasonably large.
# powerbi/*.pbix
